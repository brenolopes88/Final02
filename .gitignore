# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Pytest
.pytest_cache/

# IDEs and editors
.vscode/
.idea/

# Input assets and source files
# Keep actual input folders tracked, but ignore generated outputs inside them.
# The generated voice outputs below are still ignored.

# System files
.DS_Store
Thumbs.db

# Logs, temp and caches
*.log
temp/
tmp/
.cache/

# Streamlit secrets
.streamlit/secrets.toml

# Local environment / secrets
.env
.env.*
*.pem
*.key
secrets.json

# Generated project outputs (ignore by default; remove if you want to version projects)
/projects/

# Roteiros, provavelmente descontinuado
/roteiros/

# Input assets: track only the reference voices, cards, and tarot knowledge.
inputs/audio_assets/
inputs/fonts/
inputs/videos_fundo/
inputs/vozes_geradas/
inputs/modelos_rvc/

!inputs/voz/
!inputs/voz/**
inputs/cartas/
!inputs/cartas/**
!inputs/tarot_knowledge.json

# Generated audio/video and large media caches
models/

# ffmpeg binaries are not tracked in this repo
ffmpeg.exe
ffprobe.exe

# Misc
__pycache__/